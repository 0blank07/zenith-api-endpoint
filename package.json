{
  "name": "renderz-fc-mobile-api",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Production-ready FC Mobile player data extractor and API wrapper",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "search": "ts-node src/index.ts search",
    "latest": "ts-node src/index.ts latest",
    "rating": "ts-node src/index.ts rating",
    "export": "ts-node src/index.ts export",
    "sync": "ts-node src/index.ts sync",
    "revert-sync": "ts-node src/index.ts revert-sync",
    "update-dict": "ts-node src/scripts/updateDictionary.ts",
    "update-tree": "ts-node src/scripts/extractSkillTree.ts",
    "repair-skills": "ts-node src/scripts/repairSkillRequirements.ts",
    "sync-playstyles": "ts-node src/scripts/syncPlaystyles.ts",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "fc-mobile",
    "renderz",
    "elasticsearch",
    "scraper",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "pg-format": "^1.0.4",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/pg": "^8.10.9",
    "@types/pg-format": "^1.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
