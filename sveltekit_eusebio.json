    <!--
      Ad-script gate for the edge-caching "dynamic island" model.
      This markup is byte-identical for every user, so the cached HTML shell stays
      shareable — the per-user decision happens at runtime by reading the readable
      `rz_no_ads` cookie (set server-side in hooks.server.ts from the subscription).
      Premium users carry rz_no_ads=1, so the ad bootstrapper is never injected and
      the third-party ad SDKs never boot (no stray vignettes/interstitials). Everyone
      else loads /ads-bootstrap.js at head-parse time, so there is no ad-latency hit.

      Pre-paint skeleton suppression: the cached shell is rendered logged-out, so it
      ALWAYS contains the ad-slot skeletons; without this they would paint for premium
      users until /api/me resolves and Svelte tears them down. The gate runs in <head>
      before <body> parses, so toggling the `rz-no-ads` class on <html> + the static
      rule below hides ad-slot containers (.rz-ad-wrapper) and other ad UI tagged
      .rz-ads-ui (e.g. the mobile-nav "remove ads" upsell) before the first paint. Kept
      in sync with the cookie name in
      src/lib/ads/ad-hint-cookie.constants.ts and static/ads-bootstrap.js.
    -->
    <style>
      .rz-no-ads .rz-ad-wrapper,
      .rz-no-ads .rz-ads-ui {
        display: none !important;
      }
    </style>
    <script>
      ;(function () {
        if (/(?:^|;\s*)rz_no_ads=1(?:;|$)/.test(document.cookie)) {
          document.documentElement.classList.add('rz-no-ads')
          return
        }
        var s = document.createElement('script')
        s.src = '/ads-bootstrap.js'
        s.async = true
        document.head.appendChild(s)
      })()
    </script>

    <!--
      Safe-area insets for the RN-app webview (edge-caching model). Insets vary per DEVICE
      MODEL, so they can never live in shared cached SSR markup (the rz_app cache key only
      segments platform + app version). The native shell embeds them in the webview's
      user-agent (X-Safe-Area-Insets-{json}); this gate mirrors them into CSS variables on
      <html> BEFORE <body> parses, so components style with var(--rz-inset-*, 0px) and the
      cached shell stays byte-identical for every device. On the web the UA carries no
      insets and the variables stay unset (fallback 0px).
    -->
    <script>
      ;(function () {
        var m = navigator.userAgent.match(/X-Safe-Area-Insets-({.*?})/)
        if (!m) return
        try {
          var i = JSON.parse(m[1])
          var r = document.documentElement.style
          r.setProperty('--rz-inset-top', (i.top || 0) + 'px')
          r.setProperty('--rz-inset-bottom', (i.bottom || 0) + 'px')
          r.setProperty('--rz-inset-left', (i.left || 0) + 'px')
          r.setProperty('--rz-inset-right', (i.right || 0) + 'px')
        } catch (e) {
          /* malformed insets → web defaults */
        }
      })()
    </script>

