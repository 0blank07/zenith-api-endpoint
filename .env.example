# RenderZ API Configuration
BASE_URL=https://renderz.app
SEARCH_ENDPOINT=https://renderz.app/api/search/elasticsearch

# Browser Settings
HEADLESS=true
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Cache & Storage
CACHE_ENABLED=true
SESSION_CACHE_PATH=./.session-cache.json

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=renderz_db

# Logging
LOG_LEVEL=info
